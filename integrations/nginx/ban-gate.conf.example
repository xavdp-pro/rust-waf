# Include at server{} scope; requires ngx_http_auth_request_module.
location = /.__waf_ban_gate {
    internal;
    auth_request off;
    auth_basic off;
    proxy_pass http://unix:/run/rust-waf/ban.sock:/;
    proxy_method GET;
    proxy_http_version 1.1;
    proxy_pass_request_body off;
    proxy_pass_request_headers off;
    proxy_set_header Host waf-ban-gate;
    proxy_set_header Connection close;
    proxy_set_header X-Waf-Client-IP $remote_addr;
    proxy_set_header X-Waf-Admin-Friend $waf_admin_friend;
    proxy_set_header Content-Length "";
    proxy_connect_timeout 1s;
    proxy_read_timeout 3s;
    proxy_send_timeout 3s;
    proxy_next_upstream off;
    proxy_cache off;
}
location @waf_lookup_unavailable {
    # A lookup failure never authorizes dynamic forwarding or direct PHP.
    return 502;
}
